# ============================================================
# WOLTIX FORUM - GÜVENLİK YAPILANDIRMASI
# ============================================================
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun
# cp .env.example .env
#
# Railway'e deploy için bu değişkenleri Railway Dashboard > Variables'a ekleyin
# ============================================================

# ============================================================
# TEMEL AYARLAR
# ============================================================
NODE_ENV=production
PORT=4000
FRONTEND_URL=https://woltix-frontend-production.up.railway.app

# ============================================================
# VERİTABANI
# ============================================================
# Railway PostgreSQL eklentisi otomatik olarak DATABASE_URL ayarlar
DATABASE_URL=postgresql://user:password@host:5432/woltix_forum

# ============================================================
# JWT (JSON WEB TOKEN)
# ============================================================
# Güçlü bir JWT secret oluşturmak için:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production

# ============================================================
# ENCRYPTION (Hassas veri şifreleme)
# ============================================================
# 32 byte hex key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# ============================================================
# REDIS (Opsiyonel - Önbellekleme ve Rate Limiting için)
# ============================================================
# Redis bağlantısı olmadan da çalışır, ancak önerilir
REDIS_URL=redis://:password@host:6379

# ============================================================
# ADMIN ŞİFRESİ (İlk kurulum)
# ============================================================
# Admin hesabı oluşturmak için kullanılır
ADMIN_PASSWORD=QQ55

# ============================================================
# CLOUDFLARE (Opsiyonel)
# ============================================================
# Cloudflare Turnstile (CAPTCHA alternatifi)
# https://developers.cloudflare.com/turnstile/
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Cloudflare API (WAF kuralları için)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ============================================================
# E-POSTA (Opsiyonel - Şifre sıfırlama ve bildirimler için)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@woltix.com

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=5
REGISTER_RATE_LIMIT_MAX=10
